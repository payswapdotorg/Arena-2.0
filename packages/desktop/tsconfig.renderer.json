{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    "rootDir": "src/renderer",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    // UIA-002（issue #71）：renderer 程序现在编译 @arena/workbench 源码（其表单层
    // import node:crypto —— 运行时由 vite alias 指向纯 TS shim；类型程序需要
    // node 类型；与 packages/web/tsconfig.json 的 UIA-001 集成同一手法）。
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/renderer"],
  // renderer 直接 import 了 shared；把它补进 references，避免 renderer 单独检查时再走源码回退路径。
  "references": [{ "path": "../shared" }, { "path": "../ui" }, { "path": "../client" }]
}
